# --- LLM ---
ANTHROPIC_API_KEY=
# "claude" calls the API; "mock" returns a deterministic plan (no key needed)
LLM_MODE=claude
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# --- Storage ---
# local | s3  (add more in app/storage/__init__.py)
STORAGE_BACKEND=local
LOCAL_DATA_DIR=./data
# S3_BUCKET=
# S3_PREFIX=plans/

# --- API ---
# If set, clients must send header X-API-Key
APP_API_KEY=
CORS_ORIGINS=*
